# Copy to .env, or run scripts/setup.ps1 to generate random local passwords.
POSTGRES_PASSWORD=replace_with_a_long_random_password
REDIS_PASSWORD=replace_with_another_random_password
DATABASE_URL=postgres://luma:replace_with_a_long_random_password@127.0.0.1:5432/luma?sslmode=disable
REDIS_URL=redis://:replace_with_another_random_password@127.0.0.1:6379/0
APP_ADDR=:8090
APP_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:5173,http://127.0.0.1:5173
INSTANCE_ID=local
COOKIE_SECURE=false
UPLOAD_DIR=.local/uploads
STATIC_DIR=frontend/dist
ADMIN_EMAIL=admin@luma.local
ADMIN_PASSWORD=replace_with_a_password_at_least_12_characters
SEED_DEMO=true
AGENT_EMAIL=agent@luma.local
AGENT_PASSWORD=replace_with_another_password_at_least_12_characters
# Keys and endpoint region must match. Never put keys in VITE_* variables.
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_API_KEY=
CHAT_MODEL=qwen3-vl-plus
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
MODEL_TIMEOUT=45s
SEARCH_MIN_SCORE=0.25
